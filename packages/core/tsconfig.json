{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "lib": ["ESNext"],
        "types": ["node"],
        "allowJs": true
    },
    "include": ["src/**/*.ts", "src/**/*.mjs"]
}
