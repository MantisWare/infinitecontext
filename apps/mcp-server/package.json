{
  "name": "infinitecontext-mcp-server",
  "type": "module",
  "version": "0.1.0",
  "exports": {
    "./server": "./src/server.ts",
    "./handler": "./src/handler.ts",
    "./types": "./src/types.ts",
    "./reader-sdk": "./src/reader-sdk.ts"
  },
  "bin": {
    "infinitecontext-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node -e \"const fs=require('node:fs'); const p='dist/stdio.mjs'; const j='dist/stdio.js'; if(fs.existsSync(p)) fs.copyFileSync(p,j);\"",
    "check": "pnpm run build",
    "dev": "tsx src/stdio.ts",
    "test": "node --import tsx --test src/**/*.test.ts tests/**/*.test.mjs"
  },
  "dependencies": {
    "@infinitecontext/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "infinitecontext": "workspace:*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsdown": "^0.20.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
