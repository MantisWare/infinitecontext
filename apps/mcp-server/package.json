{
  "name": "infinitecontext-mcp-server",
  "type": "module",
  "version": "0.1.0",
  "exports": {
    "./server": "./src/server.ts",
    "./handler": "./src/handler.ts",
    "./types": "./src/types.ts",
    "./reader-sdk": "./src/reader-sdk.ts"
  },
  "bin": {
    "infinitecontext-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node -e \"const fs=require('node:fs'); fs.copyFileSync('dist/stdio.mjs','dist/stdio.js');\"",
    "prepack": "pnpm --filter infinitecontext run build && pnpm run build",
    "check": "pnpm run build",
    "dev": "tsx src/stdio.ts",
    "test": "node ../../scripts/run-node-test.mjs --import ../../scripts/ic-test-tmp-preload.mjs --import tsx -- 'src/**/*.test.ts' 'tests/**/*.test.mjs'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "infinitecontext": "workspace:*",
    "@types/node": "^22.18.6",
    "tsdown": "^0.20.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
