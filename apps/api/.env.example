# Choose one provider: postgres | supabase
DATABASE_PROVIDER="postgres"

# Postgres provider (match apps/postgres/.env.example — password is required there)
DATABASE_URL="postgresql://infinitecontext:YOUR_POSTGRES_PASSWORD@127.0.0.1:5433/infinitecontext"

# Supabase provider (optional — bring your own project)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

INFINITECONTEXT_ADMIN_KEY=""
INFINITECONTEXT_TEST_API_KEY=""

# Account auth (Phase 1)
INFINITECONTEXT_JWT_SECRET=""
INFINITECONTEXT_ACCESS_TOKEN_TTL_SEC="900"
INFINITECONTEXT_REFRESH_TOKEN_TTL_SEC="604800"
INFINITECONTEXT_AUTH_PUBLIC_BASE_URL="http://127.0.0.1:8787"
INFINITECONTEXT_GOOGLE_CLIENT_ID=""
INFINITECONTEXT_GOOGLE_CLIENT_SECRET=""
INFINITECONTEXT_JWT_ISSUER="http://127.0.0.1:8787"
INFINITECONTEXT_JWT_AUDIENCE="infinitecontext-api"
INFINITECONTEXT_ALLOW_CONSOLE_MAILER="false"
INFINITECONTEXT_TRUSTED_PROXY="false"
# Default mailer for self-host: SMTP (free). Resend is optional.
INFINITECONTEXT_MAIL_PROVIDER="smtp"
INFINITECONTEXT_RESEND_API_KEY=""
INFINITECONTEXT_MAIL_FROM="InfiniteContext <noreply@example.com>"
INFINITECONTEXT_SMTP_HOST="127.0.0.1"
INFINITECONTEXT_SMTP_PORT="587"
INFINITECONTEXT_SMTP_SECURE="false"
INFINITECONTEXT_SMTP_USER=""
INFINITECONTEXT_SMTP_PASS=""
