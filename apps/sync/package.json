{
  "name": "@infinitecontext/sync",
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#parsers": "@infinitecontext/parsers",
    "#parsers/utils": "@infinitecontext/parsers/utils",
    "#sync-cursor": "./src/sync-cursor-shim.mjs"
  },
  "scripts": {
    "pack:standalone": "node scripts/pack-from-staging.mjs",
    "start": "node src/index.mjs",
    "stop": "node -e \"import('./src/ctl.mjs').then(m => { process.argv[2]='stop'; m.runCtl(); })\"",
    "dev": "node src/dev.mjs",
    "dev:daemon": "node --watch src/index.mjs",
    "dev:tui": "node --watch -e \"await import('./src/env.mjs'); const {tuiBoot} = await import('./src/tui.mjs'); const {resolveHostAuthHooks}=await import('./src/host-auth.mjs'); tuiBoot({...(await resolveHostAuthHooks())});\"",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "exports": {
    "./sync": "./src/daemon.mjs",
    "./tui": "./src/tui.mjs",
    "./store": "./src/store.mjs",
    "./ctl": "./src/ctl.mjs",
    "./launcher": "./src/launcher.mjs",
    "./onboarding-preferences": "./src/onboarding-preferences.mjs",
    "./recent-projects": "./src/recent-projects.mjs",
    "./ui/hero-art": "./src/ui/hero-art.mjs",
    "./ui/constants": "./src/ui/constants.mjs",
    "./Spinner": "./src/Spinner.mjs"
  },
  "dependencies": {
    "@infinitecontext/sync-cursor": "workspace:*",
    "@infinitecontext/parsers": "workspace:*",
    "@mishieck/ink-titled-box": "^0.4.2",
    "dotenv": "^17.2.3",
    "fast-glob": "^3.3.3",
    "figlet": "^1.10.0",
    "ink": "^6.7.0",
    "react": "^19.2.4"
  },
  "files": [
    "src"
  ]
}
