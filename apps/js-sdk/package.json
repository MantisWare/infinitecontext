{
    "name": "infinitecontext",
    "description": "JavaScript/TypeScript SDK + CLI for the InfiniteContext API",
    "type": "module",
    "version": "1.5.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "bin": {
        "infinitecontext": "infinitecontext.mjs"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "check": "node --check src/cli/entry.mjs && node --check src/cli/login.mjs && node --check lib/credentials.mjs && pnpm run build",
        "prepack": "pnpm run build",
        "postinstall": "node postinstall.mjs",
        "test": "node --test tests/**/*.test.mjs"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MantisWare/infinitecontext.git",
        "directory": "apps/js-sdk"
    },
    "author": "Waldo Marais / MantisWare",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/MantisWare/infinitecontext/issues"
    },
    "homepage": "https://infinitecontext.ai",
    "keywords": [
        "ai",
        "llm",
        "context",
        "agents",
        "ai-agents",
        "context-engineering",
        "context-management",
        "context-window",
        "versioning",
        "time-travel",
        "rollback",
        "chat",
        "conversation",
        "typescript",
        "cli",
        "daemon",
        "tui"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./credentials": "./lib/credentials.mjs"
    },
    "files": [
        "dist/",
        "lib/",
        "infinitecontext.mjs",
        "postinstall.mjs",
        "assets/",
        "plugin/"
    ],
    "dependencies": {
        "@mishieck/ink-titled-box": "^0.4.2",
        "fast-glob": "^3.3.3",
        "figlet": "^1.10.0",
        "ink": "^6.7.0",
        "react": "^19.2.4"
    },
    "devDependencies": {
        "@infinitecontext/parsers": "workspace:*",
        "@infinitecontext/sync": "workspace:*",
        "node-pty": "^1.1.0",
        "tsdown": "^0.20.3",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.28.1"
}
