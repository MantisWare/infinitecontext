# Shared env file for daemon + TUI (monorepo root).
# Use either INFINITECONTEXT_API_KEY or `infinitecontext login` (stores ~/.infinitecontext/credentials.json).
INFINITECONTEXT_API_KEY=ic_live_xxx
# Context API (default: free hosted tier). Override for self-host:
INFINITECONTEXT_BASE_URL=https://api.infinitecontext.ai
# Set to 1 to disable the optional npm registry version check (no telemetry)
INFINITECONTEXT_NO_UPDATE_CHECK=
DAEMON_ENGINEER_ID=engineer-01
DAEMON_HOST=
DAEMON_POLL_MS=1500
DAEMON_LOG_LEVEL=info
DAEMON_VERBOSE=false
DAEMON_LOG_APPENDS=true
TUI_REFRESH_MS=1200
TUI_RECENT_LIMIT=10
TUI_SOUND_ENABLED=true
TUI_STARTUP_SOUND_ENABLED=true
TUI_CONTEXT_SOUND_ENABLED=true
INFINITECONTEXT_CONFIG_FILE=../../.infinitecontext/config.json
INFINITECONTEXT_DB_FILE=../../.infinitecontext/daemon.db
INFINITECONTEXT_LOCK_FILE=../../.infinitecontext/daemon.lock
INFINITECONTEXT_DAEMON_WS_HOST=127.0.0.1
INFINITECONTEXT_DAEMON_WS_PORT=0
INFINITECONTEXT_DAEMON_INFO_FILE=../../.infinitecontext/daemon.info
INFINITECONTEXT_DAEMON_LOG_FILE=../../.infinitecontext/daemon.log
DAEMON_BOOTSTRAP_MODE=prompt
DAEMON_BOOTSTRAP_RESET=false

# Source toggles
INGEST_CODEX=true
INGEST_CLAUDE=true
INGEST_OPENCLAW=true

# Glob patterns
CODEX_GLOB=~/.codex/sessions/**/*.jsonl
CLAUDE_GLOB=~/.claude/projects/**/*.jsonl
OPENCLAW_GLOB=~/.openclaw/agents/*/sessions/**/*.jsonl
CLAUDE_INCLUDE_SUBAGENTS=false

# Resume workflow (pull sessions from InfiniteContext)
RESUME_CONTEXT_LIMIT=200
RESUME_SOURCE_FILTER=all
RESUME_OPEN_TAB=true
RESUME_SUMMARY_TAIL=14
RESUME_OUTPUT_DIR=~/.codex/resume
