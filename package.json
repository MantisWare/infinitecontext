{
  "name": "infinitecontext-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "check": "pnpm -r --if-present run check",
    "dev:sync": "pnpm --filter @infinitecontext/sync run dev",
    "dev:tui": "pnpm --filter @infinitecontext/sync run dev:tui",
    "infinitecontext:api": "pnpm --filter infinitecontext-api run dev",
    "infinitecontext:db:up": "cd apps/postgres && docker compose up -d",
    "infinitecontext:db:down": "cd apps/postgres && docker compose down",
    "infinitecontext:db:reset": "cd apps/postgres && docker compose down -v && docker compose up -d",
    "infinitecontext:db:migrate": "bash ./apps/postgres/scripts/infinitecontext-db-migrate.sh",
    "infinitecontext:key:local": "bash ./apps/api/scripts/infinitecontext-dev-key.sh",
    "infinitecontext:migrate": "pnpm run infinitecontext:db:migrate",
    "infinitecontext:sync": "pnpm --filter @infinitecontext/sync run start",
    "infinitecontext:stop": "pnpm --filter @infinitecontext/sync run stop"
  }
}
